# ---- Database (Supabase free Postgres) ----
# Supabase dashboard -> Connect -> "Session pooler" URI (IPv4-friendly, port 5432).
# Do NOT use the 6543 transaction pooler (LangGraph's checkpointer needs session semantics).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connections per backend process. The session pooler caps ALL clients (free plan: 15), and a
# deploy briefly runs two instances, plus any local backend on the same DB. Max per process =
# DB_POOL_SIZE + DB_MAX_OVERFLOW + CHECKPOINT_POOL_SIZE (default 7).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
CHECKPOINT_POOL_SIZE=2

# ---- LLM / memory providers ----
GROQ_API_KEY=
JINA_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=story_memory

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# ---- Models (any Groq model id works) ----
# List what your key can use: GET https://api.groq.com/openai/v1/models
# Defaults suit Groq's free tier (8k tokens/min and 1k requests/day per model): writing on 120b,
# checking/extraction on 20b so they use separate quotas. Avoid qwen/qwen3.8-27b on free
# (1k output tokens/min cap rejects planner and episode calls).
PLANNER_MODEL=openai/gpt-oss-120b
WRITER_MODEL=openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-20b
EXTRACTOR_MODEL=openai/gpt-oss-20b
UTILITY_MODEL=openai/gpt-oss-20b
# low | medium | high, for gpt-oss models only (reasoning tokens count against max_tokens)
REASONING_EFFORT=low

# ---- Bounds ----
MAX_REVISIONS=2
MAX_EPISODE_COST_USD=0.05
MAX_STORY_COST_USD=5.0

# ---- Optional: LangSmith tracing of every graph step ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=serial-story

# true = run the whole pipeline with fake LLM / embeddings / vector store (tests, CI, no keys)
OFFLINE_MODE=false
